{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://family-health-graph-staging.onrender.com"
      },
      "android": { "buildType": "apk" }
    },
    "pilot": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://family-health-graph.onrender.com"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "pilot": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    }
  }
}
